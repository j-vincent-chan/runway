# From Supabase → Project Settings → API Keys
# Use the Publishable key (sb_publishable_...), not the legacy anon key.
# Never commit .env.local. Rotate keys if they were ever shared.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Optional legacy fallback:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Account that inherits the pre-auth lab workspace (default.json + browser :local).
# Every other login gets an empty private dataset. Defaults to vincent.chan@ucsf.edu.
# NEXT_PUBLIC_LAB_OWNER_EMAIL=vincent.chan@ucsf.edu

# After updating schema.sql: enable Email auth in Supabase and sign in via /login
# for private cloud sync. Local-only mode works without these vars.

# Lock In handoff email (server-only — never NEXT_PUBLIC_).
# Create a Resend account (resend.com), verify a sender, and set both.
# RESEND_API_KEY=re_...
# LOCKIN_FROM_EMAIL=runway@yourdomain.org
