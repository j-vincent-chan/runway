# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# Real finance exports — keep local; use Upload in the app
*.xlsx
*.xls
/financial-reports/
# Sanitized fixtures only (if added under fixtures/)
!fixtures/**/*.xlsx
!fixtures/**/*.xls
# Generated chartstring helper export (may contain real account strings)
/exports/*.xlsx
# Generated email previews (scripts/email-preview.ts)
/exports/email-previews/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code: shared project config is committed, personal overrides are not
.claude/settings.local.json
